#!/bin/bash
# Pre-commit hook: fix trailing newlines, lint shell scripts, format staged Java,
# scan for secrets, then test and check staged Java files.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

scan_staged_secrets() {
  if command -v gitleaks >/dev/null 2>&1; then
    echo "Scanning for secrets..."
    if ! gitleaks git --staged --no-banner 2>&1; then
      echo ""
      echo "Commit blocked: gitleaks found potential secrets in staged changes."
      exit 1
    fi
  else
    echo "Warning: gitleaks not installed, skipping secret scan (brew install gitleaks)"
  fi
}

# --- end-of-file-fixer: ensure staged files end with a newline ---
while IFS= read -r -d '' file; do
  if [ ! -s "$file" ]; then
    continue
  fi
  grep -Iq . "$file" || continue
  if [ "$(tail -c 1 "$file" | wc -l)" -eq 0 ]; then
    if git diff --quiet -- "$file"; then
      printf '\n' >> "$file"
      git add -- "$file"
    else
      echo "Warning: $file has no trailing newline but has unstaged changes; fix it manually."
    fi
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACM)

# --- shellcheck: lint staged shell scripts ---
if command -v shellcheck >/dev/null 2>&1; then
  shell_files=()
  while IFS= read -r -d '' file; do
    if head -1 "$file" 2>/dev/null | grep -qE '^#!.*(bash|sh)'; then
      shell_files+=("$file")
    fi
  done < <(git diff --cached --name-only -z --diff-filter=ACM)
  if [ ${#shell_files[@]} -gt 0 ]; then
    echo "Linting shell scripts..."
    if ! shellcheck "${shell_files[@]}" 2>&1; then
      echo ""
      echo "Commit blocked: fix shellcheck warnings above before committing."
      exit 1
    fi
  fi
else
  echo "Warning: shellcheck not installed, skipping shell lint (brew install shellcheck)"
fi

# --- Java-specific checks (only if .java files staged) ---
# --quiet exits 0 when no staged .java changes exist. A grep -q pipe here can
# exit 141 under pipefail if git diff takes a SIGPIPE, silently skipping the hook.
if git diff --cached --quiet -- '*.java'; then
  scan_staged_secrets
  exit 0
fi

echo "Running formatter..."
if ! ./gradlew spotlessApply 2>&1; then
  echo ""
  echo "Commit blocked: formatter failed."
  exit 1
fi
git diff --name-only -z -- '*.java' | xargs -r -0 git add

scan_staged_secrets

echo "Running tests..."
if ! ./gradlew test 2>&1; then
  echo ""
  echo "Commit blocked: fix test failures above before committing."
  exit 1
fi

echo "Running Checkstyle..."
if ! ./gradlew checkstyleMain checkstyleTest 2>&1; then
  echo ""
  echo "Commit blocked: fix Checkstyle violations above before committing."
  exit 1
fi
